NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin for auth email redirects (password reset). Optional locally.
# Falls back to request Host / VERCEL_URL / https://ffs-mission-control.netlify.app
NEXT_PUBLIC_SITE_URL=https://ffs-mission-control.netlify.app

# Temporary personal bypass (disable once normal auth + migration 0004 work)
FP_STUDIO_PERSONAL_BYPASS=false
# Optional extra gate for the bypass form. If unset and bypass is true, one-click is allowed.
FP_STUDIO_BYPASS_SECRET=
# Required for personal bypass data access (service role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server actions use the signed-in user's session and RLS. No LLM key is required in Phase 1.
# Optional Phase 1 storage: create a private Supabase Storage bucket named "campaign-assets".

# Phase 2 generation providers (optional, server-only — never expose to the browser).
# Without these keys, jobs fail clearly with not_configured (no fake successes).
# OPENAI_API_KEY=
# GOOGLE_OMNI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# FAL_KEY=
# XAI_API_KEY=
# RUNWAYML_API_SECRET=
# RUNWAY_API_KEY=   # optional alias for RUNWAYML_API_SECRET

# Job Operator (Phase 0 schema only — no provider required yet).
# BRIEF_ANALYSIS_PROVIDER=mock

# Runway default model: gpt_image_2 (1–41 credits by quality). Gen-4/muse promptText ≤1000 UTF-16; gpt_image_2 ≤32000 code units.
